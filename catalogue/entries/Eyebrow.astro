---
import Eyebrow from '../../components/Eyebrow.astro';
import Specimen from '../Specimen.astro';
---

<Specimen
  title="Eyebrow"
  code={`<Eyebrow>What You'll Make</Eyebrow>
<Eyebrow as="p">Meet BASIC, Unit 1</Eyebrow>`}
  note="One outlined square box, four cells tall (§7), at the micro step (§6; the concept's 0.66rem was off the scale). No colour of its own (§3, §7). Written in title case in the content itself (§4); nothing transforms it."
>
  <Eyebrow>What You'll Make</Eyebrow>
  <Eyebrow>Every Machine, Every Language</Eyebrow>
  <Eyebrow as="p">Meet BASIC, Unit 1</Eyebrow>
</Specimen>

<Specimen
  title="Above a heading"
  code={`<Eyebrow>An Honest Ask</Eyebrow>
<h2>…</h2>`}
  note="It introduces the heading; the heading carries the outline."
  block
>
  <Eyebrow>An Honest Ask</Eyebrow>
  <h2 style="margin: var(--h-space-3) 0 0; font: var(--h-weight-major) var(--h-text-h2)/var(--h-lh-h2) var(--h-font-ui); letter-spacing: var(--h-tr-h2); color: var(--h-ink);">Keep it going</h2>
</Specimen>
