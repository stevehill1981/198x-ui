---
/**
 * A loading state: what this machine showed while it was busy loading.
 *
 * Governed by 198x/decisions/family-visual-identity.md:
 *
 * - §7: "A loading state shows what that machine showed while it was busy,
 *   quoted from a source, never borrowed from another machine." Each machine's
 *   look is data in loading-looks.ts, every value cited beside it. A machine
 *   with no entry fails the build with a clear error; there is no default
 *   look to fall back on, because any default would be another machine's.
 * - §7, "Captures are shown as the machine showed them": anything the machine
 *   printed is a real Emu198x capture from loading-captures/, never text set
 *   in a font. The machines drew their messages from their own character ROMs,
 *   and a capture is the only faithful quotation of that. Captures show at a
 *   whole multiple of their grid, by the same rule as Screen (screen-fit.ts),
 *   and are never tinted, overlaid or filtered.
 * - What changed too fast to capture is drawn: the Spectrum's border stripes,
 *   the C64's blanked field, the Amiga's greys and white. Drawn frames are the
 *   same box as the captures, on the same grid, so nothing jumps between them.
 * - §7: a screen is an object, so the look sits in Screen's bezel: rounded,
 *   dark in both themes, the `--h-screen-*` tokens, and the frame's glow is the
 *   machine lighting itself. There are no scanlines or bloom: the drawn frames
 *   are not captures, and a sequence that switched them on and off would flicker.
 * - §6: the machine's own loading display while something loads is on the
 *   allowed list of motion. Under prefers-reduced-motion: reduce nothing moves
 *   or changes: the look shows its busy state as one still frame.
 *
 * What each machine shows (sources and how each capture was made are in
 * loading-looks.ts):
 *
 * - **ZX Spectrum** (tape): "Program: GAME" once the header is read, the
 *   border white and then cyan (captures); then the data block's stripes, red
 *   and cyan for the pilot and blue and yellow for the data, drawn around the
 *   capture's own paper. The stripes rise, but slower than the machine's 114
 *   lines a second, which would flash every point of the border about twelve
 *   times a second (WCAG 2.3.1). Band heights, colours, order and direction
 *   are the machine's.
 * - **Commodore 64** (`media="tape"`, the default): PRESS PLAY ON TAPE
 *   (capture), the whole screen blanked to light blue, FOUND GAME (capture),
 *   then blanked again while it loads, which it holds. The KERNAL never shows
 *   LOADING while a tape loads: it prints it and blanks the screen on the same
 *   frame. No stripes: those were commercial turbo loaders, not the KERNAL's.
 * - **Commodore 64** (`media="disk"`, a 1541): SEARCHING FOR GAME, then
 *   LOADING (captures), on the normal blue screen, with the drive's red light.
 * - **Amiga 500** (Kickstart 1.3): the whole screen dark grey, light grey,
 *   then white, with the drive light lit. The white is the insert-disk
 *   screen's ground; Commodore's hand-and-disk picture is not reproduced.
 * - **NES, Master System** (cartridge): the program is in the machine already,
 *   so there is no loading state and Loading renders nothing. Show the content
 *   at once. A site can ask first with `loadingLook(machine).kind === 'none'`
 *   from loading-looks.ts.
 *
 * The program is always GAME. A capture shows the name it was made with, so
 * Loading takes no `name`: passing one throws rather than show a name the
 * screen does not. Use the status text for what is really loading.
 *
 * A sequence plays once, from when the element is first rendered, and holds
 * its last state, the one the machine spent its busy time in; only stripes
 * keep moving, because they did. Remove the component when loading ends.
 *
 * Accessibility: the root is role="status" and its text, "Loading…" and the
 * machine, is what assistive technology gets. The picture is aria-hidden and
 * its images have empty alt: the machine's messages are part of a picture
 * here, not content, and the status text carries the meaning at full
 * contrast. `showLabel` puts the status text under the screen for sighted
 * readers too.
 *
 * Size: the screen is the machine's own grid as Emu198x captures it
 * (Spectrum 352x296, C64 416x312, Amiga 320x256) at a whole multiple up to
 * `maxScale`, fitted in the browser like Screen; only a cell narrower than the
 * grid scales it down. Stripes are sized in source lines, so they stay in
 * proportion at any scale.
 *
 * Props:
 *   machine    The machine's id, as in machines.json: 'sinclair-zx-spectrum',
 *              'commodore-64', 'commodore-amiga', 'nintendo-entertainment-system'.
 *              Required.
 *   media      For a machine with more than one loader: the C64's 'tape'
 *              (default) or 'disk'.
 *   label      The status text before the machine's name. Default 'Loading…'.
 *   showLabel  Show the status text under the screen. Default false.
 *   maxScale   Largest whole multiple of the grid. Default 1.
 *   class      Extra classes for the root.
 */
import { loadingLook, type Capture, type Stripes } from './loading-looks';

interface Props {
  machine: string;
  media?: string;
  label?: string;
  showLabel?: boolean;
  maxScale?: number;
  class?: string;
}

const {
  machine,
  media,
  label = 'Loading…',
  showLabel = false,
  maxScale = 1,
  class: className,
} = Astro.props;

if (!machine) throw new Error('[198x-ui] Loading: machine is required.');
if ('name' in Astro.props) {
  throw new Error(
    '[198x-ui] Loading: `name` was removed. The machine\'s messages are real captures of a ' +
      'program named GAME, and a capture cannot show another name. Put what is loading in `label`.',
  );
}
const look = loadingLook(machine, media);

/* The captures, as URLs the bundler emits. Same-origin, as Screen needs. */
const captureUrls = import.meta.glob<string>('./loading-captures/*.png', {
  eager: true,
  query: '?url',
  import: 'default',
});
const urlOf = (c: Capture) => {
  const url = captureUrls[`./loading-captures/${c.file}`];
  if (!url) throw new Error(`[198x-ui] Loading: no capture loading-captures/${c.file}, named in loading-looks.ts.`);
  return url;
};

type Shown = {
  style: string;
  last: boolean;
  fill?: string;
  capture?: { src: string; width: number; height: number };
  stripes?: { css: string; period: number; seconds: number };
  paper?: { src: string; width: number; height: number; clip: string };
};
let frames: Shown[] | null = null;
let status = '';
let rootStyle = '';
let led: { colour: string; from: number } | undefined;
let grid = { w: 0, h: 0 };

if (look.kind === 'look') {
  grid = look.grid;
  /* One repeating gradient per pattern, its stops in source lines. A tile
     repeated hundreds of times is what Safari stops painting part-way down a
     tall layer; a single repeating gradient is not. */
  const gradient = (s: Stripes) => {
    let at = 0;
    const stops = s.bands.map((h, i) => {
      const c = s.colours[i % 2];
      const from = at;
      at += h;
      return `${c} calc(var(--h-load-px) * ${from.toFixed(2)}) calc(var(--h-load-px) * ${at.toFixed(2)})`;
    });
    return { css: `repeating-linear-gradient(to bottom, ${stops.join(', ')})`, period: Math.round(at * 100) / 100 };
  };

  const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(4)}%`;
  const p = look.paper;
  const paperClip = p
    ? `inset(${pct(p.y, grid.h)} ${pct(grid.w - p.x - p.w, grid.w)} ${pct(grid.h - p.y - p.h, grid.h)} ${pct(p.x, grid.w)})`
    : '';

  const drift = look.drift ?? 0;
  frames = look.frames.map((f, i) => {
    const next = look.frames[i + 1];
    const shown: Shown = {
      style: [`--h-load-at:${f.at}s`, next ? `--h-load-until:${next.at}s` : ''].filter(Boolean).join(';'),
      last: !next,
    };
    if ('capture' in f) {
      if (f.capture.width !== grid.w || f.capture.height !== grid.h) {
        throw new Error(`[198x-ui] Loading: ${f.capture.file} is ${f.capture.width}x${f.capture.height}; ${look.title} is ${grid.w}x${grid.h}.`);
      }
      shown.capture = { src: urlOf(f.capture), width: f.capture.width, height: f.capture.height };
    } else if ('fill' in f) {
      shown.fill = f.fill;
    } else {
      const pattern = look.stripes?.[f.stripes];
      if (!pattern) throw new Error(`[198x-ui] Loading: ${look.title} has no "${f.stripes}" stripes in loading-looks.ts.`);
      if (!p) throw new Error(`[198x-ui] Loading: ${look.title} draws stripes but gives no paper rectangle.`);
      const g = gradient(pattern);
      shown.stripes = { ...g, seconds: drift > 0 ? Math.round((g.period / drift) * 1000) / 1000 : 0 };
      shown.paper = { src: urlOf(f.paper), width: f.paper.width, height: f.paper.height, clip: paperClip };
    }
    return shown;
  });

  rootStyle = `--h-load-gw:${grid.w};--h-load-gh:${grid.h}`;
  status = `${label} ${look.title}`;
  led = look.led;
}
const scale = Math.max(1, Math.floor(maxScale));
---

{frames && (
  <div class:list={['h-load', className]} role="status" style={rootStyle} data-machine={machine}>
    <div class="h-load-device" data-h-load-fit data-gw={grid.w} data-gh={grid.h} data-max-scale={scale}>
      <div class="h-load-screen" aria-hidden="true">
        {frames.map((f) => (
          <div class:list={['h-load-frame', { 'h-load-last': f.last }]} style={f.style + (f.fill ? `;background:${f.fill}` : '')}>
            {f.capture && (
              <img class="h-load-img" src={f.capture.src} width={f.capture.width} height={f.capture.height} alt="" decoding="async" />
            )}
            {f.stripes && (
              <div
                class:list={['h-load-stripes', { 'h-load-drift': f.stripes.seconds > 0 }]}
                style={`--h-load-period:${f.stripes.period};--h-load-seconds:${f.stripes.seconds}s;background-image:${f.stripes.css}`}
              ></div>
            )}
            {f.paper && (
              <img class="h-load-img" src={f.paper.src} width={f.paper.width} height={f.paper.height} alt="" decoding="async" style={`clip-path:${f.paper.clip}`} />
            )}
          </div>
        ))}
      </div>
      {led && <span class="h-load-led" aria-hidden="true" style={`--h-load-led:${led.colour};--h-load-at:${led.from}s`}></span>}
    </div>
    <span class:list={['h-load-status', { 'h-load-status-hidden': !showLabel }]}>{status}</span>
  </div>
)}

<style>
  .h-load {
    display: grid;
    justify-items: start;
    gap: calc(var(--h-cell) * 1.5);
    min-width: 0;
  }

  /* The device: the screen in Screen's bezel, with room for a drive light.
     The script sizes it to a whole multiple of the grid (screen-fit.ts);
     until it runs, or without JavaScript, it sits at 1x capped to its cell. */
  .h-load-device {
    --h-load-margin: 0.6rem;
    position: relative;
    width: min(calc(var(--h-load-gw) * 1px), 100% - 2 * var(--h-load-margin));
    margin: var(--h-load-margin);
  }
  @media (max-width: 420px) {
    .h-load-device { --h-load-margin: 3px; }
  }

  .h-load-screen {
    position: relative;
    aspect-ratio: var(--h-load-gw) / var(--h-load-gh);
    /* Source pixels resolve against this box, so every stripe is in
       proportion at any width. */
    container-type: inline-size;
    overflow: hidden;
    isolation: isolate;
    border-radius: 1.4rem / 1.6rem;
    background: var(--h-screen-glass);
    box-shadow:
      0 0 0 0.6rem var(--h-screen-bezel),
      0 0 0 calc(0.6rem + 1px) var(--h-screen-rim),
      0 0 60px 0 var(--h-screen-glow);
  }

  .h-load-frame {
    --h-load-px: calc(100cqw / var(--h-load-gw));
    position: absolute;
    inset: 0;
    overflow: hidden;
    visibility: hidden;
    /* Appear at --h-load-at, give way at --h-load-until. */
    animation:
      h-load-on 1ms linear var(--h-load-at) forwards,
      h-load-off 1ms linear var(--h-load-until) forwards;
  }
  .h-load-frame.h-load-last { animation: h-load-on 1ms linear var(--h-load-at) forwards; }

  @keyframes h-load-on { from, to { visibility: visible; } }
  @keyframes h-load-off { from, to { visibility: hidden; } }

  /* The stripes: one layer a period taller than the screen, drifting up by
     exactly one period and starting again, so the loop has no seam. */
  .h-load-stripes {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: calc(100% + var(--h-load-px) * var(--h-load-period));
    will-change: transform;
  }
  .h-load-drift { animation: h-load-rise var(--h-load-seconds) linear infinite; }
  @keyframes h-load-rise {
    from { transform: translateY(0); }
    to { transform: translateY(calc(var(--h-load-px) * var(--h-load-period) * -1)); }
  }

  /* A capture, whole or (in a stripes frame) only its paper, clipped to the
     paper's rectangle on the grid. Its pixels are never filtered or tinted. */
  .h-load-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  /* A drive light: an object, so round; on the bezel below the screen. */
  .h-load-led {
    position: absolute;
    right: 1.6rem;
    bottom: calc(-0.6rem + 0.3rem - 3px);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2a2622;
    animation: h-load-led 1ms linear var(--h-load-at) forwards;
  }
  @keyframes h-load-led {
    from, to {
      background: var(--h-load-led);
      box-shadow: 0 0 6px 1px var(--h-load-led);
    }
  }

  .h-load-status {
    padding-inline: 0.6rem;
    font-family: var(--h-font-ui);
    font-size: var(--h-text-micro);
    line-height: var(--h-lh-micro);
    color: var(--h-ink-muted);
  }
  .h-load-status-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* §6: under reduced motion nothing moves or changes. The busy state shows
     as one still frame, the drive light already lit. */
  @media (prefers-reduced-motion: reduce) {
    .h-load-frame,
    .h-load-frame.h-load-last,
    .h-load-drift,
    .h-load-led { animation: none; }
    .h-load-frame.h-load-last { visibility: visible; }
    .h-load-led {
      background: var(--h-load-led);
      box-shadow: 0 0 6px 1px var(--h-load-led);
    }
  }
</style>

<script>
  /* Fit every Loading on the page to a whole multiple of its grid, by the
     same rule as Screen. The grid is declared, so no pixels are read. */
  import { fitToGrid, refitOnChange } from './screen-fit';

  const fitLoads = () =>
    document.querySelectorAll<HTMLElement>('[data-h-load-fit]').forEach((el) => {
      fitToGrid(el, Number(el.dataset.gw), Number(el.dataset.gh));
    });

  fitLoads();
  refitOnChange(fitLoads);
  (window as unknown as { fitLoads: () => void }).fitLoads = fitLoads;
</script>
