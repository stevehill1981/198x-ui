---
/**
 * Top-level navigation, shared across the family sites.
 *
 * Deliberately knows nothing about any site's information architecture: items
 * arrive as props. A shared nav that knows the routes is a shared nav that has
 * to be edited to add a page to one site.
 */
import Plate from './Plate.astro';

interface NavItem {
  label: string;
  href: string;
  /**
   * Marks this entry as where the reader is.
   *
   * `true` (or `'page'`) means this entry IS the page being shown, and emits
   * `aria-current="page"`. `'section'` means the page sits inside this
   * entry's branch without being it, and emits `aria-current="true"` — the
   * value ARIA defines for "the current item in a set" when it is not the
   * page itself.
   *
   * The distinction is not cosmetic. Emitting `page` for an ancestor tells a
   * screen-reader user that a link to somewhere else is the document they are
   * on, which is worse than marking nothing at all.
   */
  current?: boolean | 'page' | 'section';
}

interface Props {
  prefix: string;
  project?: 'code' | 'emu' | 'asm' | 'cat' | 'build' | 'debug' | 'isa' | 'forge' | 'play';
  items: NavItem[];
  /**
   * Shown at the end of the nav. A bare version number gains a `v`; anything
   * else is rendered as given, so a caller can pass a state rather than a
   * number ("main @ e8e784b") without it becoming "vmain".
   */
  version?: string;
  homeHref?: string;
}

const { prefix, project, items, version, homeHref = '/' } = Astro.props;

/**
 * `true` keeps meaning `page`, so every existing caller is unaffected.
 */
function ariaCurrent(current: NavItem['current']) {
  if (current === 'section') return 'true';
  return current ? 'page' : undefined;
}
const shown = version ? (/^\d/.test(version) ? `v${version}` : version) : null;
---

<header class="h-nav">
  <Plate prefix={prefix} project={project} href={homeHref} />

  <nav class="h-nav-items" aria-label="Primary">
    {items.map((item) => (
      <a href={item.href}
         class:list={['h-nav-link', {
           current: item.current === true || item.current === 'page',
           section: item.current === 'section',
         }]}
         aria-current={ariaCurrent(item.current)}>{item.label}</a>
    ))}
    {shown && <span class="h-nav-version">{shown}</span>}
  </nav>
</header>

<style>
  .h-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem var(--h-inset);
    border-bottom: 1px solid var(--h-line);
    background: var(--h-page);
  }

  .h-nav-items {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-family: var(--h-font-ui);
    font-size: 0.85rem;
  }

  .h-nav-link {
    color: var(--h-ink-muted);
    text-decoration: none;
    text-underline-offset: 0.18em;
  }

  .h-nav-link:hover { color: var(--h-accent-ink); text-decoration: underline; }
  .h-nav-link.current { color: var(--h-ink); font-weight: 600; }
  /* A section is where you are heading, not where you are: the same ink, no
     added weight. Weight is reserved for the page itself so the two states
     stay tellable apart without relying on colour. */
  .h-nav-link.section { color: var(--h-ink); }
  .h-nav-link:focus-visible { outline: 2px solid var(--h-accent); outline-offset: 3px; }

  .h-nav-version {
    font-family: var(--h-font-mono);
    font-size: 0.78rem;
    /* Small informational text, so --h-ink-muted rather than the decorative
       --h-ink-faint. See tokens.css. */
    color: var(--h-ink-muted);
  }

  @media (max-width: 40rem) {
    .h-nav { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  }
</style>
