---
/**
 * The family wordmark: two cells with a full-height rule between them.
 *
 * The prefix cell varies and carries the project colour; the `198x` cell never
 * changes. The frame is constant house brown (paper on dark), never the project
 * colour — nine fills of differing strength still read as one set because the
 * edge is shared. See 198x/decisions/family-visual-identity.md §1 and §2.
 *
 * The type is drawn as outlines from `wordmarks/glyphs.json`, not set as text.
 * The geometry is computed from JetBrains Mono's 600-unit advance and the
 * divider sits at a fixed offset, so a host that has not loaded the face would
 * otherwise get a fallback mono whose advance does not match. Outlines make the
 * plate render identically on every site regardless of what fonts loaded.
 *
 * `wordmarks/generate.py` reads the same glyph file and mirrors the geometry
 * below. Change one and change the other, or the assets drift from what the
 * sites render.
 */
import glyphData from '../wordmarks/glyphs.json';

type Project =
  | 'code' | 'emu' | 'asm' | 'cat' | 'build' | 'debug'
  | 'isa' | 'forge' | 'play' | 'format' | 'studio';

interface Props {
  /** Shown in the left cell. Rendered upper-case. A–Z and 0–9. */
  prefix: string;
  /** Picks the fill from the token set. Omit for an unfilled plate. */
  project?: Project;
  /** Cell type size in px. The plate scales from this. */
  size?: number;
  /** Wraps the plate in a link when given. */
  href?: string;
  /** Accessible name. Defaults to "<Prefix>198x". */
  label?: string;
}

const { prefix, project, size = 14, href, label } = Astro.props;

const name = label ?? `${prefix.charAt(0).toUpperCase()}${prefix.slice(1).toLowerCase()}198x`;
const fill = project ? `var(--h-project-${project})` : 'transparent';
const ink = project ? '#faf8f2' : 'var(--h-ink)';
const Tag = href ? 'a' : 'span';

const { upem, advance, capHeight, glyphs } = glyphData as {
  upem: number; advance: number; capHeight: number; glyphs: Record<string, string>;
};

const left = prefix.toUpperCase();
const right = '198x';

const unknown = [...left].filter((c) => !(c in glyphs));
if (unknown.length) {
  console.warn(
    `[198x-ui] Plate: no outline for ${unknown.map((c) => `"${c}"`).join(', ')} ` +
    `in prefix "${prefix}". Covered: A–Z and 0–9. The cell keeps its width and ` +
    `the glyph is omitted. Add it to wordmarks/glyphs.json to fix.`,
  );
}

/* Geometry — mirrors wordmarks/generate.py. */
const F = size;
const ADV = 0.6 * F;               // JetBrains Mono advance width
const PAD_X = 0.6 * F;
const PAD_Y = 0.34 * F;
const STROKE = (2 / 14) * F;       // 2px border at the default size of 14
const RADIUS = (3 / 14) * F;
const LETTER_SPACING_UNITS = -10;  // -0.01em, in font units

const wLeft = left.length * ADV + 2 * PAD_X;
const wRight = right.length * ADV + 2 * PAD_X;
const h = F + 2 * PAD_Y;
const w = wLeft + wRight + STROKE;      // one shared divider line
const ow = w + STROKE;                  // room for the outer stroke
const oh = h + STROKE;
const o = STROKE / 2;
/* Centre the cap-height band in the cell rather than sitting the type on a text
   baseline. The names are uppercase with no descenders, so a text baseline
   leaves 0.34em above the caps and 0.59em below — a 0.125em list that reads as
   the type riding high. Centring on cap height rather than each string's ink
   keeps every plate on one baseline. */
const CAP = capHeight / upem;
const baseline = o + (h + CAP * F) / 2;

const n = (v: number) => Number(v.toFixed(2));
const scale = F / upem;
const step = advance + LETTER_SPACING_UNITS;

/** One text run as outlines: a scaled group, one path per glyph. */
const run = (text: string, x: number) =>
  [...text]
    .map((ch, i) =>
      ch in glyphs
        ? `<path d="${glyphs[ch]}"${i ? ` transform="translate(${i * step} 0)"` : ''}/>`
        : '',
    )
    .join('');

// Deterministic: identical plates share a clip path, which is harmless —
// the rect is identical. Random ids would churn the build output.
const clipId = `h-plate-${left.toLowerCase()}-${n(ow)}`.replace(/\./g, '-');
---

<Tag
  class="h-plate"
  href={href}
  aria-label={name}
  style={`--plate-radius:${n(RADIUS)}px;`}
>
  <svg
    width={n(ow)}
    height={n(oh)}
    viewBox={`0 0 ${n(ow)} ${n(oh)}`}
    role="img"
    aria-hidden="true"
    focusable="false"
  >
    <clipPath id={clipId}>
      <rect x={n(o)} y={n(o)} width={n(w)} height={n(h)} rx={n(RADIUS)} />
    </clipPath>
    <g clip-path={`url(#${clipId})`}>
      <rect x={n(o)} y={n(o)} width={n(wLeft)} height={n(h)} fill={fill} />
      <rect
        x={n(o + wLeft)} y={n(o)}
        width={n(wRight + STROKE)} height={n(h)}
        fill="var(--h-plate-cell)"
      />
    </g>
    <rect
      x={n(o)} y={n(o)} width={n(w)} height={n(h)} rx={n(RADIUS)}
      fill="none" stroke="var(--h-plate-frame)" stroke-width={n(STROKE)}
    />
    <line
      x1={n(o + wLeft + STROKE / 2)} y1={n(o)}
      x2={n(o + wLeft + STROKE / 2)} y2={n(o + h)}
      stroke="var(--h-plate-frame)" stroke-width={n(STROKE)}
    />
    <g
      fill={ink}
      transform={`translate(${n(o + PAD_X)} ${n(baseline)}) scale(${scale.toFixed(4)} -${scale.toFixed(4)})`}
      set:html={run(left, 0)}
    />
    <g
      fill="var(--h-ink)"
      transform={`translate(${n(o + wLeft + STROKE + PAD_X)} ${n(baseline)}) scale(${scale.toFixed(4)} -${scale.toFixed(4)})`}
      set:html={run(right, 0)}
    />
  </svg>
</Tag>

<style>
  .h-plate {
    display: inline-flex;
    border-radius: var(--plate-radius);
    box-shadow: var(--h-plate-shadow);
    line-height: 0;
    text-decoration: none;
  }

  .h-plate svg {
    display: block;
  }

  a.h-plate:focus-visible {
    outline: 2px solid var(--h-accent);
    outline-offset: 3px;
  }
</style>
