---
/**
 * Tabs, or a segmented control: one of several options is current.
 *
 * Governed by 198x/decisions/family-visual-identity.md:
 *
 * - §7: interface, so square cells on the 8px grid, flat. The current option
 *   is in inverse video, because inverse means *current* and nothing else. It
 *   switches instantly, as the attribute byte does.
 * - §3 and §7: no option takes a colour of its own. Options that need telling
 *   apart get a mark in their label, not a hue.
 *
 * Two modes, from whether panels are given:
 *
 * - **Tabs** (a `panel-N` slot per tab): the WAI-ARIA tabs pattern. A tablist
 *   of tab buttons, each controlling a tabpanel labelled by its tab.
 * - **Segmented** (no panels): a radiogroup of radio buttons. A tablist with
 *   nothing to control is a tablist that lies, so a control that only picks a
 *   value says so. The host listens for the change event and does the rest.
 *
 * Keyboard, in both: the group is one Tab stop (roving tabindex), on the
 * current option. Arrow keys (along the orientation for tabs, either axis for
 * a radio group, as the APG patterns have it) move to the next or
 * previous option and wrap; Home and End go to the first and last. Moving
 * selects (automatic activation): panels here are already rendered, so
 * showing one costs nothing.
 *
 * Every change dispatches `h-tabs-change` on the component's root, bubbling,
 * with `detail: { index, value }`.
 *
 * Without JavaScript, tabs show every panel in order and hide the tablist,
 * so nothing is unreachable; a segmented control shows its initial value.
 *
 * Props:
 *   items        The options: `{ label, value? }[]`. `value` defaults to the
 *                label, and is what the change event reports.
 *   label        The group's accessible name. Required: a tablist or radio
 *                group without one is a list of unexplained choices.
 *   selected     Index of the current option. Default 0.
 *   orientation  'horizontal' (default; Left/Right) or 'vertical' (Up/Down).
 *   id           A base for the element ids. Default: generated.
 *   class        Extra classes for the root.
 *
 * Slots: `panel-0`, `panel-1`, … one per item, for tabs mode. Give all or
 * none; a partial set throws.
 */
interface Item {
  label: string;
  value?: string;
}

interface Props {
  items: Item[];
  label: string;
  selected?: number;
  orientation?: 'horizontal' | 'vertical';
  id?: string;
  class?: string;
}

const {
  items,
  label,
  selected = 0,
  orientation = 'horizontal',
  id = `h-tabs-${Math.random().toString(36).slice(2, 9)}`,
  class: className,
} = Astro.props;

if (!label) throw new Error('[198x-ui] Tabs: label is required.');
if (items.length < 2) throw new Error('[198x-ui] Tabs: give at least two items.');
if (selected < 0 || selected >= items.length) {
  throw new Error(`[198x-ui] Tabs: selected=${selected} is outside 0..${items.length - 1}.`);
}

const given = items.map((_, i) => Astro.slots.has(`panel-${i}`));
const tabs = given.every(Boolean);
if (!tabs && given.some(Boolean)) {
  throw new Error('[198x-ui] Tabs: give a panel-N slot for every item, or none (a segmented control).');
}

const panels = tabs ? await Promise.all(items.map((_, i) => Astro.slots.render(`panel-${i}`))) : [];
---

<div
  class:list={['h-tabs', `h-tabs-${orientation}`, { 'h-tabs-panelled': tabs }, className]}
  id={id}
  data-h-tabs={tabs ? 'tabs' : 'segmented'}
  data-orientation={orientation}
>
  <div
    class="h-tabs-list"
    role={tabs ? 'tablist' : 'radiogroup'}
    aria-label={label}
    aria-orientation={tabs ? orientation : undefined}
  >
    {items.map((item, i) => (
      <button
        type="button"
        class="h-tabs-tab"
        id={`${id}-tab-${i}`}
        role={tabs ? 'tab' : 'radio'}
        aria-selected={tabs ? String(i === selected) : undefined}
        aria-checked={tabs ? undefined : String(i === selected)}
        aria-controls={tabs ? `${id}-panel-${i}` : undefined}
        tabindex={i === selected ? 0 : -1}
        data-value={item.value ?? item.label}
      >{item.label}</button>
    ))}
  </div>

  {tabs && panels.map((html, i) => (
    <div
      class="h-tabs-panel"
      id={`${id}-panel-${i}`}
      role="tabpanel"
      aria-labelledby={`${id}-tab-${i}`}
      tabindex="0"
      hidden={i !== selected}
      set:html={html}
    />
  ))}

  {tabs && (
    <noscript>
      <style is:inline>
        [data-h-tabs="tabs"] > [role="tablist"] { display: none; }
        [data-h-tabs="tabs"] > [role="tabpanel"][hidden] { display: block; }
      </style>
    </noscript>
  )}
</div>

<style>
  .h-tabs-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--h-cell);
  }
  .h-tabs-vertical > .h-tabs-list { flex-direction: column; }

  .h-tabs-tab {
    box-sizing: border-box;
    min-height: calc(var(--h-cell) * 5);
    padding: 0 calc(var(--h-cell) * 2);
    border: 1px solid var(--h-line);
    border-radius: 0;
    background: var(--h-shell);
    color: var(--h-ink-body);
    font-family: var(--h-font-ui);
    font-size: var(--h-text-micro);
    line-height: 1;
    font-weight: var(--h-weight-minor);
    text-align: left;
    cursor: pointer;
  }

  .h-tabs-tab:hover,
  .h-tabs-tab.is-hover { background: var(--h-wash); color: var(--h-ink); }

  .h-tabs-tab:focus-visible,
  .h-tabs-tab.is-focus {
    outline: 2px solid var(--h-accent);
    outline-offset: 2px;
  }

  /* Current: inverse video, instantly. */
  .h-tabs-tab[aria-selected="true"],
  .h-tabs-tab[aria-checked="true"] {
    background: var(--h-ink);
    border-color: var(--h-ink);
    color: var(--h-ground);
  }

  .h-tabs-panelled > .h-tabs-panel { margin-top: calc(var(--h-cell) * 2); }
  .h-tabs-panel:focus-visible { outline: 2px solid var(--h-accent); outline-offset: 2px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-h-tabs]').forEach((root) => {
    const isTabs = root.dataset.hTabs === 'tabs';
    const vertical = root.dataset.orientation === 'vertical';
    const list = root.querySelector<HTMLElement>(':scope > .h-tabs-list')!;
    const options = [...list.querySelectorAll<HTMLButtonElement>(':scope > .h-tabs-tab')];
    const panels = [...root.querySelectorAll<HTMLElement>(':scope > .h-tabs-panel')];
    const attr = isTabs ? 'aria-selected' : 'aria-checked';

    const select = (n: number, focus: boolean) => {
      const was = options.findIndex((o) => o.getAttribute(attr) === 'true');
      options.forEach((o, i) => {
        o.setAttribute(attr, String(i === n));
        o.tabIndex = i === n ? 0 : -1;
      });
      panels.forEach((p, i) => { p.hidden = i !== n; });
      if (focus) options[n].focus();
      if (was !== n) {
        root.dispatchEvent(new CustomEvent('h-tabs-change', {
          bubbles: true,
          detail: { index: n, value: options[n].dataset.value },
        }));
      }
    };

    options.forEach((o, i) => o.addEventListener('click', () => select(i, false)));

    list.addEventListener('keydown', (e) => {
      const at = options.indexOf(document.activeElement as HTMLButtonElement);
      if (at < 0) return;
      const last = options.length - 1;
      // Tabs follow their orientation; a radio group takes both axes (APG).
      const next = isTabs ? [vertical ? 'ArrowDown' : 'ArrowRight'] : ['ArrowDown', 'ArrowRight'];
      const prev = isTabs ? [vertical ? 'ArrowUp' : 'ArrowLeft'] : ['ArrowUp', 'ArrowLeft'];
      const to =
        next.includes(e.key) ? (at === last ? 0 : at + 1)
        : prev.includes(e.key) ? (at === 0 ? last : at - 1)
        : e.key === 'Home' ? 0
        : e.key === 'End' ? last
        : -1;
      if (to < 0) return;
      e.preventDefault();
      select(to, true);
    });
  });
</script>
